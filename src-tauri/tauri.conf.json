{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WotlkClones",
  "version": "1.0.0",
  "identifier": "com.wotlkclones.app",
  "mainBinaryName": "WotlkClones",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WOTLK Clones",
        "label": "main",
        "width": 980,
        "height": 860,
        "minWidth": 760,
        "minHeight": 640,
        "resizable": true,
        "maximized": true,
        "center": true,
        "backgroundColor": "#090b10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "copyright": "WOTLK Clones",
    "shortDescription": "WOTLK Clones - Config Sync 3.3.5a",
    "longDescription": "Copia SavedVariables, config-cache.wtf, macros-cache.txt, layout-cache.txt, addons.txt y bindings-cache.wtf entre cuentas y personajes de Wrath of the Lich King (cliente 3.3.5a).",
    "publisher": "WOTLK Clones",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
